# ---- Virtual environments ----
myenv/
.venv/
venv/
env/
ENV/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Data (large / regenerable) ----
data/raw/
data/interim/
data/external/
data/processed/
# ...but keep the manifests -- they are the source of truth and tiny
!data/manifests/
!data/manifests/**
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.amr

# ---- Model / experiment artifacts (never commit weights) ----
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.pkl
*.joblib
*.npy
*.npz
*.safetensors
*.bin
# repo-root weights dir (NOT src/voiceguard/models/) -- gitignore forbids
# trailing comments on pattern lines, so keep these bare
/models/
!/models/**/MODEL_CARD.md
# ...but DO track the small fixed upstream reference weights (clovaai/aasist)
!/models/pretrained/
!/models/pretrained/*.pth
# ...except the per-machine calibration json (regenerates on first demo run)
/models/pretrained/*_demo_calib.json
baselines/artifacts/
results/**/*.pkl
results/wav2vec2_finetuned/
results/wav2vec2_finetuned_backup/
mlruns/
wandb/
catboost_info/

# ---- Keep tracked results ----
!results/tables/**/*.csv
!results/figures/**/*.png

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Logs / OS / IDE ----
*.log
logs/
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Scratch ----
scratch/
*.tmp
